        <mxCell id="k36" value="&lt;b&gt;Überfällige Rückgabe&lt;/b&gt; (unterwegs und ende &amp;lt; heute)&lt;br&gt;rotes Banner auf index.php für Fahrer und Fuhrparkleiter · der Fahrer kann nichts buchen, nicht als Fahrer eingetragen werden und keine weitere Fahrt beginnen · das Fahrzeug kann nicht genehmigt werden" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6c27a;fontColor=#1f2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k37" value="&lt;b&gt;Fahrt beginnen ist gesperrt&lt;/b&gt; (sperre_fahrtbeginn()), solange&lt;br&gt;• der Fahrer selbst eine überfällige Rückgabe hat&lt;br&gt;• das Fahrzeug von der vorigen Fahrt noch nicht zurück ist&lt;br&gt;• das Fahrzeug in Wartung steht" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6c27a;fontColor=#1f2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="770" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k38" value="&lt;b&gt;Stornieren&lt;/b&gt; – siehe Reiter „Status“&lt;br&gt;durch Antragsteller oder Fahrer, solange offen oder genehmigt; automatisch, wenn der Fuhrparkleiter das Fahrzeug im Zeitraum in Wartung setzt" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6c27a;fontColor=#1f2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="770" width="420" height="100" as="geometry" />
        </mxCell>
