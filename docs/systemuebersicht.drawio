        <mxCell id="k31" value="offen&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;&quot;&gt;behoben_am = NULL&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fdf6e7;strokeColor=#b7791f;fontColor=#1f2933;fontSize=13;fontStyle=1;align=center;strokeWidth=1.5;" vertex="1" parent="1">
