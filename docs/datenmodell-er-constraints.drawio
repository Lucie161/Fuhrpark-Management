        <mxCell id="legende" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#ffffff;strokeColor=#7a8ca3;" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#c9a227;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Datenbank&lt;/b&gt; prüft selbst (CHECK, UNIQUE)&lt;br&gt;&lt;span style=&quot;color:#8e5cc4;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Nur PHP-Code&lt;/b&gt; prüft, die DB nicht&lt;br&gt;&lt;br&gt;&lt;b&gt;Fremdschlüssel&lt;/b&gt;&lt;br&gt;ON UPDATE CASCADE überall&lt;br&gt;ON DELETE RESTRICT, außer&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;nutzer_fuehrerscheine&lt;/span&gt;: CASCADE&lt;br&gt;&lt;i&gt;(Nutzer mit Buchungen sind nicht löschbar,&lt;/i&gt;&lt;br&gt;&lt;i&gt;Fahrzeuge mit Fahrtenbuch auch nicht)&lt;/i&gt;" vertex="1">
          <mxGeometry height="196" width="320" x="-360" y="80" as="geometry" />
        </mxCell>
        <mxCell id="chk_fz" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#fff8e1;strokeColor=#c9a227;" value="&lt;b&gt;CHECK / UNIQUE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;uq_fahrzeuge_kennzeichen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;UNIQUE (kennzeichen)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_fahrzeuge_sitzplaetze&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;sitzplaetze &amp;gt;= 1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Status und Ende der Wartung stehen nicht&lt;/i&gt;&lt;br&gt;&lt;i&gt;in fahrzeuge, sie kommen aus wartungen (R5).&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="290" x="1250" y="840" as="geometry" />
        </mxCell>
        <mxCell id="chk_fz_e" edge="1" parent="1" source="chk_fz" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="fahrzeuge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chk_b" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#fff8e1;strokeColor=#c9a227;" value="&lt;b&gt;CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_buchungen_zeitraum&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;ende &amp;gt;= start&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_buchungen_personenanzahl&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;personenanzahl &amp;gt;= 1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_buchungen_km&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;km_ende &amp;gt;= km_start&lt;/span&gt;&lt;br&gt;&lt;i&gt;NULL besteht die Prüfung&lt;/i&gt;" vertex="1">
