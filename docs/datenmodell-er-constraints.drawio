        <mxCell id="chk_sf_e" edge="1" parent="1" source="chk_sf" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="schadensfotos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chk_w" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#fff8e1;strokeColor=#c9a227;" value="&lt;b&gt;CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_wartungen_bis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis &amp;gt;= begonnen_am&lt;/span&gt;&lt;br&gt;&lt;i&gt;NULL (Ende offen) besteht die Prüfung&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_wartungen_freigegeben&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;(freigegeben_am IS NULL)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;= (freigegeben_von IS NULL)&lt;/span&gt;&lt;br&gt;&lt;i&gt;Freigabe: Tag und Person, sonst keins&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="280" x="1680" y="340" as="geometry" />
        </mxCell>
        <mxCell id="chk_w_e" edge="1" parent="1" source="chk_w" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="wartungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_beleg" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R1 Keine Doppelbelegung&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;Zwei Buchungen desselben Fahrzeugs dürfen&lt;br&gt;sich nicht überschneiden:&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;b1.fahrzeug_id = b2.fahrzeug_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;AND b1.start &amp;lt;= b2.ende&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;AND b2.start &amp;lt;= b1.ende&lt;/span&gt;&lt;br&gt;&lt;br&gt;zählt beim &lt;b&gt;Buchen&lt;/b&gt;: offen, genehmigt, unterwegs&lt;br&gt;zählt beim &lt;b&gt;Genehmigen&lt;/b&gt;: genehmigt, unterwegs&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;genehmigung_hindernis()&lt;/span&gt;&lt;br&gt;&lt;i&gt;Gerechnet wird in ganzen Tagen. Die DB kann das&lt;/i&gt;&lt;br&gt;&lt;i&gt;nicht prüfen: CHECK sieht nur eine Zeile.&lt;/i&gt;" vertex="1">
          <mxGeometry height="228" width="380" x="830" y="840" as="geometry" />
        </mxCell>
        <mxCell id="php_beleg_e" edge="1" parent="1" source="php_beleg" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_buchen" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R2 Buchen&lt;/b&gt; (PHP, serverseitig erneut geprüft)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;start &amp;gt;= heute&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;zweck&lt;/span&gt; Pflicht&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;personenanzahl &amp;lt;= fahrzeuge.sitzplaetze&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;fahrzeuge.fuehrerschein&lt;/span&gt; muss in&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;nutzer_fuehrerscheine&lt;/span&gt; des Fahrers stehen&lt;br&gt;&lt;i&gt;(NULL = kein Führerschein nötig)&lt;/i&gt;&lt;br&gt;Zweck montage, materialtransport ⇒&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;art IN (&#39;auto&#39;, &#39;transporter&#39;)&lt;/span&gt;&lt;br&gt;Fahrzeug nicht in Wartung (R5), Rückgabe&lt;br&gt;nicht überfällig, Fahrer nicht gesperrt (R4)" vertex="1">
          <mxGeometry height="196" width="380" x="830" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="php_buchen_e" edge="1" parent="1" source="php_buchen" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;exitX=0;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_status" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R3 Statusübergänge&lt;/b&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;buchungen.status&lt;/span&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;offen → genehmigt | abgelehnt&lt;/span&gt; (Fuhrparkleiter)&lt;br&gt;&lt;i&gt;abgelehnt: entscheidung_kommentar Pflicht&lt;/i&gt;&lt;br&gt;Roller, Fahrrad: sofort &lt;span style=&quot;font-family:monospace;&quot;&gt;genehmigt&lt;/span&gt;,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;entscheidung_von&lt;/span&gt; bleibt NULL &lt;span style=&quot;font-family:monospace;&quot;&gt;(braucht_genehmigung())&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;offen | genehmigt → storniert&lt;/span&gt;&lt;br&gt;&lt;i&gt;durch Antragsteller oder Fahrer, oder automatisch (R5)&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;genehmigt → unterwegs&lt;/span&gt; nur der Fahrer,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;start &amp;lt;= heute &amp;lt;= ende&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;sperre_fahrtbeginn()&lt;/span&gt;&lt;br&gt;&lt;i&gt;setzt begonnen_am, km_start = fahrzeuge.kmstand&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;unterwegs → abgeschlossen&lt;/span&gt; (Rückgabe)&lt;br&gt;&lt;i&gt;setzt zurueckgegeben_am, km_ende; kmstand = km_ende&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;überfällig:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;status = &#39;unterwegs&#39; AND ende &amp;lt; heute&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="440" x="60" y="840" as="geometry" />
        </mxCell>
        <mxCell id="php_status_e" edge="1" parent="1" source="php_status" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_rolle" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R4 Rollen und Sperren&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;rolle = fuhrparkleiter&lt;/span&gt; für&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;entscheidung_von&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;behoben_von&lt;/span&gt;,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;angelegt_von&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_von&lt;/span&gt;&lt;br&gt;Fuhrparkleiter bucht nicht selbst&lt;br&gt;&lt;br&gt;Wer eine überfällige Rückgabe hat, bucht&lt;br&gt;nichts und ist nicht als Fahrer wählbar&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;sperre_buchen()&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="320" x="-360" y="380" as="geometry" />
        </mxCell>
        <mxCell id="php_rolle_e" edge="1" parent="1" source="php_rolle" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="nutzer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_w" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R5 Wartung&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;b&gt;laufend&lt;/b&gt; = &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_am IS NULL&lt;/span&gt;,&lt;br&gt;höchstens eine laufende je Fahrzeug&lt;br&gt;Fahrzeug gesperrt bis einschließlich&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis&lt;/span&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;(wartung_sperrt())&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis&lt;/span&gt; NULL oder vorbei ⇒&lt;br&gt;Ende offen, für jeden Zeitraum gesperrt&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;(wartung_ende_offen())&lt;/span&gt;&lt;br&gt;Anlegen: &lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis &amp;gt;= heute&lt;/span&gt; Pflicht,&lt;br&gt;storniert offene und genehmigte Buchungen&lt;br&gt;im Zeitraum&lt;br&gt;Freigeben: markiert den auslösenden Schaden&lt;br&gt;als behoben&lt;br&gt;&lt;i&gt;status und wartung_bis eines Fahrzeugs werden&lt;/i&gt;&lt;br&gt;&lt;i&gt;aus der laufenden Wartung berechnet (LEFT JOIN).&lt;/i&gt;" vertex="1">
          <mxGeometry height="276" width="370" x="1680" y="550" as="geometry" />
        </mxCell>
        <mxCell id="php_w_e" edge="1" parent="1" source="php_w" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="wartungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_s" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R6 Schäden&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;beschreibung&lt;/span&gt; Pflicht&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;anlass = &#39;uebernahme&#39;&lt;/span&gt; ⇒ &lt;span style=&quot;font-family:monospace;&quot;&gt;schwere = &#39;klein&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;schwere = &#39;wartung&#39;&lt;/span&gt; ⇒ neue Zeile in&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;wartungen&lt;/span&gt; mit &lt;span style=&quot;font-family:monospace;&quot;&gt;schaden_id&lt;/span&gt;, Ende offen,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;angelegt_von = NULL&lt;/span&gt;&lt;br&gt;behoben markieren nur der Fuhrparkleiter;&lt;br&gt;bei Wartungsschaden stattdessen „freigeben“" vertex="1">
          <mxGeometry height="164" width="340" x="1000" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="php_s_e" edge="1" parent="1" source="php_s" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="schaeden">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_sf" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R7 Fotos&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;höchstens 3 je Schaden, je 5 MB&lt;br&gt;JPEG, PNG, WebP, geprüft mit &lt;span style=&quot;font-family:monospace;&quot;&gt;finfo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;datei = bin2hex(random_bytes(16))&lt;/span&gt; + Endung&lt;br&gt;sieht nur der Fuhrparkleiter" vertex="1">
          <mxGeometry height="116" width="300" x="1400" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="php_sf_e" edge="1" parent="1" source="php_sf" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="schadensfotos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
