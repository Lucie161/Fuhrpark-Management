        <mxCell id="b_freigabe_1" connectable="0" parent="b_freigabe" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#2f5d8a;verticalAlign=bottom;spacingBottom=1;align=right;spacingRight=6;" value="0..1" vertex="1">
          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint as="offset" />
