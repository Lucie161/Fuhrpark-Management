        <mxCell id="hinweis_schluessel" value="&lt;b&gt;Schlüsseltabellen&lt;/b&gt; (graue Kopfzeile)&lt;br&gt;&lt;br&gt;Feste Wertelisten statt ENUM: &lt;span style=&quot;font-family:monospace;&quot;&gt;id&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;bezeichnung&lt;/span&gt;.&lt;br&gt;Die IDs sind fest vergeben und entsprechen&lt;br&gt;den Konstanten in &lt;span style=&quot;font-family:monospace;&quot;&gt;includes/konstanten.php&lt;/span&gt;,&lt;br&gt;z. B. &lt;span style=&quot;font-family:monospace;&quot;&gt;STATUS_UNTERWEGS = 3&lt;/span&gt;.&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;buchungsstatus&lt;/span&gt; ist nach dem Ablauf&lt;br&gt;geordnet: 1–3 belegen das Fahrzeug,&lt;br&gt;4–6 sind erledigt." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f1f4f8;strokeColor=#6b7c93;" vertex="1" parent="1">
