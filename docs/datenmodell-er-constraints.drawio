        <mxCell id="chk_s" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#fff8e1;strokeColor=#c9a227;" value="&lt;b&gt;CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;chk_schaeden_behoben&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;(behoben_am IS NULL)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;= (behoben_von IS NULL)&lt;/span&gt;&lt;br&gt;&lt;i&gt;behoben: Zeitpunkt und Person,&lt;/i&gt;&lt;br&gt;&lt;i&gt;sonst keins von beiden&lt;/i&gt;" vertex="1">
          <mxGeometry height="132" width="250" x="1680" y="170" as="geometry" />
        </mxCell>
        <mxCell id="chk_s_e" edge="1" parent="1" source="chk_s" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="schaeden">
