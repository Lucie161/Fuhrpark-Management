        <mxCell id="chk_b_e" edge="1" parent="1" source="chk_b" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
