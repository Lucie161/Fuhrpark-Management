        </mxCell>
        <mxCell id="legende" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#ffffff;strokeColor=#7a8ca3;" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#c9a227;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Datenbank&lt;/b&gt; prüft selbst (UNIQUE)&lt;br&gt;&lt;span style=&quot;color:#8e5cc4;&quot;&gt;■&lt;/span&gt; &lt;b&gt;PHP-Code&lt;/b&gt; prüft, die DB nicht&lt;br&gt;&lt;span style=&quot;color:#6b7c93;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Schlüsseltabelle&lt;/b&gt; (feste Werteliste)&lt;br&gt;&lt;br&gt;&lt;b&gt;Fremdschlüssel&lt;/b&gt;&lt;br&gt;ohne ON DELETE / ON UPDATE, also RESTRICT:&lt;br&gt;nichts wird mitgeändert oder mitgelöscht.&lt;br&gt;&lt;i&gt;Nutzer und Fahrzeuge werden nicht gelöscht,&lt;/i&gt;&lt;br&gt;&lt;i&gt;sondern bekommen &lt;span style=&quot;font-family:monospace;&quot;&gt;geloescht_am&lt;/span&gt;.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Kein CHECK&lt;/b&gt; (Feedback 15.10.2026): Werte&lt;br&gt;prüft nur PHP, sonst an zwei Stellen gepflegt." vertex="1">
          <mxGeometry height="230" width="320" x="-360" y="80" as="geometry" />
        </mxCell>
        <mxCell id="chk_fz" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;Fahrzeuge&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;sitzplaetze &amp;gt;= 1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;kennzeichen&lt;/span&gt; ist &lt;b&gt;nicht&lt;/b&gt; eindeutig: Ein&lt;br&gt;ausgemustertes Fahrzeug behält seins im&lt;br&gt;Fahrtenbuch, ein Nachfolger darf dasselbe&lt;br&gt;bekommen.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;geloescht_am&lt;/span&gt; gesetzt ⇒ ausgemustert:&lt;br&gt;nicht in Buchen, Kalender, Fahrzeugliste;&lt;br&gt;Steckbrief und Fahrtenbuch bleiben.&lt;br&gt;&lt;br&gt;&lt;i&gt;Status und Ende der Wartung stehen nicht&lt;/i&gt;&lt;br&gt;&lt;i&gt;in fahrzeuge, sie kommen aus wartungen (R5).&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="300" x="1250" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="chk_fz_e" edge="1" parent="1" source="chk_fz" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="fahrzeuge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chk_sf" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#fff8e1;strokeColor=#c9a227;" value="&lt;b&gt;UNIQUE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;uq_schadensfotos_datei&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;UNIQUE (datei)&lt;/span&gt;" vertex="1">
          <mxGeometry height="84" width="220" x="1680" y="40" as="geometry" />
        </mxCell>
        <mxCell id="chk_sf_e" edge="1" parent="1" source="chk_sf" style="endArrow=none;dashed=1;html=1;strokeColor=#c9a227;strokeWidth=1.5;" target="schadensfotos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_beleg" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R1 Keine Doppelbelegung&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;Zwei Buchungen desselben Fahrzeugs dürfen&lt;br&gt;sich nicht überschneiden:&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;b1.fahrzeug_id = b2.fahrzeug_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;AND b1.start &amp;lt;= b2.ende&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;AND b2.start &amp;lt;= b1.ende&lt;/span&gt;&lt;br&gt;&lt;br&gt;zählt beim &lt;b&gt;Buchen&lt;/b&gt;: &lt;span style=&quot;font-family:monospace;&quot;&gt;status_id &amp;lt;= STATUS_UNTERWEGS&lt;/span&gt;&lt;br&gt;zählt beim &lt;b&gt;Genehmigen&lt;/b&gt;: genehmigt, unterwegs&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;genehmigung_hindernis()&lt;/span&gt;&lt;br&gt;&lt;i&gt;Gerechnet wird in ganzen Tagen. Die DB kann das&lt;/i&gt;&lt;br&gt;&lt;i&gt;nicht prüfen: Sie bräuchte zwei Zeilen.&lt;/i&gt;" vertex="1">
          <mxGeometry height="228" width="380" x="830" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="php_beleg_e" edge="1" parent="1" source="php_beleg" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_buchen" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R2 Buchen&lt;/b&gt; (PHP, serverseitig erneut geprüft)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;start &amp;gt;= heute&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;ende &amp;gt;= start&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;zweck_id&lt;/span&gt; Pflicht&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;1 &amp;lt;= personenanzahl &amp;lt;= fahrzeuge.sitzplaetze&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;fahrzeuge.fuehrerschein&lt;/span&gt; muss in&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;nutzer_fuehrerscheine&lt;/span&gt; des Fahrers stehen&lt;br&gt;&lt;i&gt;(NULL = kein Führerschein nötig)&lt;/i&gt;&lt;br&gt;Zweck Montage, Materialtransport ⇒&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;art_id IN (ART_AUTO, ART_TRANSPORTER)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;art_id = ART_LUXUS&lt;/span&gt; ⇒ Fahrer mit &lt;span style=&quot;font-family:monospace;&quot;&gt;darf_luxus = 1&lt;/span&gt;&lt;br&gt;Fahrzeug nicht ausgemustert, nicht in Wartung (R5),&lt;br&gt;Rückgabe nicht überfällig, Fahrer aktiv und&lt;br&gt;nicht gesperrt (R4)" vertex="1">
          <mxGeometry height="250" width="380" x="830" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="php_buchen_e" edge="1" parent="1" source="php_buchen" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;exitX=0;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_status" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R3 Statusübergänge&lt;/b&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;buchungen.status_id&lt;/span&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;OFFEN → GENEHMIGT | ABGELEHNT&lt;/span&gt; (Fuhrparkleiter)&lt;br&gt;&lt;i&gt;abgelehnt: entscheidung_kommentar Pflicht&lt;/i&gt;&lt;br&gt;Roller, Fahrrad: sofort &lt;span style=&quot;font-family:monospace;&quot;&gt;GENEHMIGT&lt;/span&gt;,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;entscheidung_von&lt;/span&gt; bleibt NULL &lt;span style=&quot;font-family:monospace;&quot;&gt;(braucht_genehmigung())&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;OFFEN | GENEHMIGT → STORNIERT&lt;/span&gt;&lt;br&gt;&lt;i&gt;durch Antragsteller oder Fahrer, oder automatisch (R5)&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;GENEHMIGT → UNTERWEGS&lt;/span&gt; nur der Fahrer,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;start &amp;lt;= heute &amp;lt;= ende&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;sperre_fahrtbeginn()&lt;/span&gt;&lt;br&gt;&lt;i&gt;setzt begonnen_am, km_start = fahrzeuge.kmstand&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;UNTERWEGS → ABGESCHLOSSEN&lt;/span&gt; (Rückgabe)&lt;br&gt;&lt;i&gt;setzt zurueckgegeben_am, km_ende; kmstand = km_ende&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;km_ende &amp;gt;= km_start&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;überfällig:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;status_id = STATUS_UNTERWEGS AND ende &amp;lt; heute&lt;/span&gt;&lt;br&gt;&lt;i&gt;Konstanten &lt;span style=&quot;font-family:monospace;&quot;&gt;STATUS_…&lt;/span&gt; aus includes/konstanten.php&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="440" x="60" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="php_status_e" edge="1" parent="1" source="php_status" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="buchungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_rolle" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R4 Rollen und Sperren&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;rolle_id = ROLLE_FUHRPARKLEITER&lt;/span&gt; für&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;entscheidung_von&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;behoben_von&lt;/span&gt;,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;angelegt_von&lt;/span&gt;, &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_von&lt;/span&gt;&lt;br&gt;Fuhrparkleiter bucht nicht selbst&lt;br&gt;&lt;br&gt;Wer eine überfällige Rückgabe hat, bucht&lt;br&gt;nichts und ist nicht als Fahrer wählbar&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;sperre_buchen()&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;geloescht_am&lt;/span&gt; gesetzt ⇒ keine Anmeldung,&lt;br&gt;nicht mehr als Fahrer wählbar&lt;br&gt;&lt;br&gt;Luxusautos fahren nur Nutzer mit&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;darf_luxus = 1&lt;/span&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;(fehlt_luxusfreigabe())&lt;/span&gt;;&lt;br&gt;ihre Kleinschäden stehen unter „Zu erledigen“" vertex="1">
          <mxGeometry height="270" width="320" x="-360" y="380" as="geometry" />
        </mxCell>
        <mxCell id="php_rolle_e" edge="1" parent="1" source="php_rolle" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="nutzer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_w" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R5 Wartung&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;b&gt;laufend&lt;/b&gt; = &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_am IS NULL&lt;/span&gt;,&lt;br&gt;höchstens eine laufende je Fahrzeug&lt;br&gt;Fahrzeug gesperrt bis einschließlich&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis&lt;/span&gt; &lt;span style=&quot;font-family:monospace;&quot;&gt;(wartung_sperrt())&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis&lt;/span&gt; NULL oder vorbei ⇒&lt;br&gt;Ende offen, für jeden Zeitraum gesperrt&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;(wartung_ende_offen())&lt;/span&gt;&lt;br&gt;Anlegen: &lt;span style=&quot;font-family:monospace;&quot;&gt;voraussichtlich_bis &amp;gt;= heute&lt;/span&gt; Pflicht,&lt;br&gt;storniert offene und genehmigte Buchungen&lt;br&gt;im Zeitraum&lt;br&gt;Freigeben: &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_am&lt;/span&gt; und &lt;span style=&quot;font-family:monospace;&quot;&gt;freigegeben_von&lt;/span&gt;&lt;br&gt;zusammen setzen; markiert den auslösenden&lt;br&gt;Schaden als behoben&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;schaden_id&lt;/span&gt; NULL: Wartung ohne Schaden&lt;br&gt;(z. B. Inspektion, HU/AU)&lt;br&gt;&lt;i&gt;in_wartung und wartung_bis eines Fahrzeugs&lt;/i&gt;&lt;br&gt;&lt;i&gt;werden aus der laufenden Wartung berechnet.&lt;/i&gt;" vertex="1">
          <mxGeometry height="330" width="370" x="1680" y="420" as="geometry" />
        </mxCell>
        <mxCell id="php_w_e" edge="1" parent="1" source="php_w" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="wartungen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_s" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R6 Schäden&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;beschreibung&lt;/span&gt; Pflicht&lt;br&gt;Gemeldet nur bei einer Buchung, vom Fahrer:&lt;br&gt;bei Übernahme oder Rückgabe;&lt;br&gt;Fahrzeug und Meldender kommen aus der Buchung&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;ANLASS_UEBERNAHME&lt;/span&gt; ⇒ &lt;span style=&quot;font-family:monospace;&quot;&gt;SCHWERE_KLEIN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;SCHWERE_WARTUNG&lt;/span&gt; ⇒ neue Zeile in &lt;span style=&quot;font-family:monospace;&quot;&gt;wartungen&lt;/span&gt;&lt;br&gt;mit &lt;span style=&quot;font-family:monospace;&quot;&gt;schaden_id&lt;/span&gt;, Ende offen, &lt;span style=&quot;font-family:monospace;&quot;&gt;angelegt_von = NULL&lt;/span&gt;&lt;br&gt;behoben markieren nur der Fuhrparkleiter,&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;behoben_am&lt;/span&gt; und &lt;span style=&quot;font-family:monospace;&quot;&gt;behoben_von&lt;/span&gt; zusammen;&lt;br&gt;bei Wartungsschaden stattdessen „freigeben“" vertex="1">
          <mxGeometry height="200" width="330" x="1680" y="160" as="geometry" />
        </mxCell>
        <mxCell id="php_s_e" edge="1" parent="1" source="php_s" style="endArrow=none;dashed=1;html=1;strokeColor=#8e5cc4;strokeWidth=1.5;" target="schaeden">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="php_sf" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontColor=#1f2933;fontSize=11;shadow=1;fillColor=#f3ebfb;strokeColor=#8e5cc4;" value="&lt;b&gt;R7 Fotos&lt;/b&gt; (PHP)&lt;br&gt;&lt;br&gt;höchstens 3 je Schaden, je 5 MB&lt;br&gt;JPEG, PNG, WebP, geprüft mit &lt;span style=&quot;font-family:monospace;&quot;&gt;finfo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;&quot;&gt;datei = bin2hex(random_bytes(16))&lt;/span&gt; + Endung&lt;br&gt;sieht nur der Fuhrparkleiter" vertex="1">
