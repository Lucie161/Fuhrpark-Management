        <mxCell id="b_freigabe" edge="1" parent="1" source="nutzer_0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#7a8ca3;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#4a5a70;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="wartungen_8" value="gibt frei">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="422" />
              <mxPoint x="10" y="800" />
              <mxPoint x="1380" y="800" />
              <mxPoint x="1380" y="564" />
            </Array>
